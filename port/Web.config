<?xml version="1.0" encoding="utf-8"?>
<!--
  Port of the PHP "KERNEL-DOCMS/Server.Config.php" + "Init.php" configuration
  onto ASP.NET 4.8 appSettings (see App_Code/AppConfig.cs).
-->
<configuration>
  <appSettings>
    <!-- === URL section (was $Config['URL']) === -->
    <add key="URL.Default.RequireWww" value="false" />
    <add key="URL.Default.SslEnabled" value="false" />
    <add key="URL.Default.Server" value="127.0.0.1" />
    <add key="URL.Default.Lang" value="en_US" />
    <add key="URL.DevPrivateServer" value="127.0.0.1" />

    <!-- === MySQL section (was $Config['MySQL']) === -->
    <add key="MySQL.Host" value="localhost" />
    <add key="MySQL.User" value="root" />
    <add key="MySQL.Pass" value="" />
    <add key="MySQL.DbName" value="darkorbit" />

    <!-- === DB singleton section (was KERNEL-DOCMS/Class.db.php hard-coded info) === -->
    <add key="DB.Instance.Host" value="127.0.0.1" />
    <add key="DB.Instance.Port" value="3306" />
    <add key="DB.Instance.User" value="root" />
    <add key="DB.Instance.Pass" value="" />
    <add key="DB.Instance.DbName" value="darkorbit" />

    <!-- === Encryption key (was new Encryption("5eqD0fpzf9JzaKWP") in Init.php) === -->
    <add key="Encryption.Key" value="5eqD0fpzf9JzaKWP" />

    <!-- === Misc (was defines in Init.php) === -->
    <add key="Maintenance.Enabled" value="false" />
    <add key="Registration.Enabled" value="true" />
    <add key="TimeZone" value="Russian Standard Time" />
    <add key="DynHost" value="127.0.0.1" />
  </appSettings>

  <connectionStrings>
    <add name="DarkOrbit"
         connectionString="server=localhost;user id=root;password=;database=darkorbit;charset=utf8;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" maxRequestLength="2097152" enableVersionHeader="false" />
    <!-- session.name in PHP was base64_encode("127.0.0.1") = MTI3LjAuMC4x -->
    <sessionState mode="InProc" cookieName="MTI3LjAuMC4x" timeout="1440" />
    <globalization culture="en-US" uiCulture="en" requestEncoding="utf-8" responseEncoding="utf-8" />
    <customErrors mode="Off" />
    <identity impersonate="false" />
  </system.web>

  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483648" />
        <fileExtensions>
          <add fileExtension=".png" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <defaultDocument>
      <files>
        <clear />
        <add value="default.aspx" />
        <add value="Default.htm" />
        <add value="index.htm" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <!--
      NOTE: the legacy PHP rewrite rule (extensionless URL -> *.php) is intentionally
      dropped here; ASP.NET pages are addressed directly (*.aspx / *.ashx).
      Static assets (css/, js/, resources/, webfonts/, swf_global/) are served as-is
      from the copied original folder structure.
    -->
    <staticContent>
      <mimeMap fileExtension=".swf" mimeType="application/x-shockwave-flash" />
    </staticContent>
  </system.webServer>
</configuration>

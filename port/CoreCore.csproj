<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DarkSpace</RootNamespace>
    <AssemblyName>DarkSpace.CoreCore</AssemblyName>
    <!-- Порт ASP.NET 4.8 (WebForms) -> ASP.NET Core 8 Razor Pages -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="8.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Legacy templates are loaded via AppEnvironment.MapPath (AppDomain.BaseDirectory),
       i.e. from the output folder, not WebRootPath — copy them next to the assembly.
       Single source of truth: templates/legacy/<Lang>/... in the project root. -->
  <ItemGroup>
    <None Update="templates\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
